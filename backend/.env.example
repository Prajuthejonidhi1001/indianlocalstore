# Copy to backend/.env and fill in. Never commit the real .env.
# Only the variables listed here are read by config/settings.py.

# ── Required ──────────────────────────────────────────────────────────────────
# No default in settings.py -- Django will not start without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# ── Core ──────────────────────────────────────────────────────────────────────
# Leave DEBUG unset (or False) anywhere that is not your own machine. With
# DEBUG=False, settings.py also turns on HSTS and forces HTTPS redirects.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# A single Postgres URL (Supabase). Omit it entirely and settings.py falls back
# to a local SQLite file at backend/db.sqlite3, which is fine for development.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ── Cache ─────────────────────────────────────────────────────────────────────
# Optional. Unset means an in-process LocMemCache (per-worker, not shared).
REDIS_URL=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API. The web app's dev server is proxied
# through Vite, so localhost is only needed if you point it straight at the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email / OTP delivery (Brevo via Anymail) ──────────────────────────────────
# Without BREVO_API_KEY, send_mail fails silently and no verification codes
# are delivered -- signup will appear to work but the OTP never arrives.
BREVO_API_KEY=
EMAIL_HOST_USER=

# ── Firebase phone auth ───────────────────────────────────────────────────────
# The public Firebase Web API key -- the same value that is already hardcoded in
# web/src/firebase.js and src/config.js. Used server-side only to verify
# phone-auth ID tokens against Google's identitytoolkit. Not a secret.
FIREBASE_WEB_API_KEY=

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# The key id is safe to expose to clients; the secret is server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Media storage (Cloudinary) ────────────────────────────────────────────────
# Setting CLOUDINARY_CLOUD_NAME switches file uploads from local disk to
# Cloudinary. On Render's free plan the disk is ephemeral, so uploads made
# without this are lost on every redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
