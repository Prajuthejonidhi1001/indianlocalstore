{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "echo 'skip root install'",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://indianlocalstore-api-cjiq.onrender.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
